      <ml id="ID89010">val n =5;
        <layout>val n =5;</layout>
      </ml>
      <color id="ID89186">
        <id>PH</id>
        <index>
          <ml>1</ml>
          <ml>n</ml>
          <id>ph</id>
        </index>
        <layout>colset PH = index ph with 1..n;</layout>
